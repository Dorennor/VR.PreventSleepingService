<ui:FluentWindow x:Class="VR.KeepAwake.Views.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="VR.KeepAwake"
                 Width="380"
                 MinWidth="0"
                 MinHeight="0"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 SizeToContent="Height"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <StackPanel>
        <ui:TitleBar Title="VR.KeepAwake"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Margin="16,4,16,16">
            <ui:CardControl Icon="{ui:SymbolIcon WeatherSunny24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Keep screen awake" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="No sleep or lock screen while on" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="Keep screen awake" IsChecked="{Binding KeepAwakeEnabled}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <TextBlock Text="Start with Windows" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="Start with Windows" IsChecked="{Binding StartWithWindows}" />
            </ui:CardControl>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
