<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>VR.KeepAwake</Product>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Keeps the idle footprint small. -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- WPF asks for cultures such as en-US when it lays out text. Without this each request throws, even though WPF catches it. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-*.ico" LogicalName="%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="VR.KeepAwake.Tests" />
  </ItemGroup>

  <!-- Published next to the exe. Shown in the solution's Scripts folder rather than in this project. -->
  <ItemGroup>
    <None Include="..\..\Scripts\*.cmd" Link="%(Filename)%(Extension)" Visible="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
